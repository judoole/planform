{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Planform architectural project v2",
  "description": "Centimeters; X right, Y down; wall endpoints on centerlines; clockwise degrees. See drawing-guide.md for geometry and evidence conventions.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "planform"
    },
    "version": {
      "const": 2
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "traceReference": {
      "$ref": "#/$defs/traceReference"
    },
    "units": {
      "const": "cm"
    },
    "showExteriorDimensions": {
      "type": "boolean",
      "description": "Show the live outside-face length of each wall in a calibrated, closed convex footprint. Omitted means hidden."
    },
    "garage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "floor": {
              "type": "number",
              "minimum": -1000000,
              "maximum": 1000000
            },
            "wallHeight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 5000
            },
            "roofPitch": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 75
            },
            "roofThickness": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 500
            },
            "ridge": { "enum": ["long", "short"] },
            "openings": {
              "type": "object",
              "maxProperties": 500,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sill": { "type": "number", "minimum": 0, "maximum": 5000 },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 5000
                  }
                }
              }
            },
            "terrain": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "section": { "$ref": "#/$defs/terrainProfile" },
                "front": { "$ref": "#/$defs/terrainProfile" },
                "right": { "$ref": "#/$defs/terrainProfile" },
                "rear": { "$ref": "#/$defs/terrainProfile" },
                "left": { "$ref": "#/$defs/terrainProfile" }
              }
            }
          }
        },
        "site": {
          "type": "object",
          "additionalProperties": false,
          "required": ["map", "northDegrees", "features"],
          "properties": {
            "map": { "$ref": "#/$defs/embeddedRaster" },
            "northDegrees": { "$ref": "#/$defs/siteAngle" },
            "calibration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["a", "b", "distanceM"],
              "properties": {
                "a": { "$ref": "#/$defs/point" },
                "b": { "$ref": "#/$defs/point" },
                "distanceM": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10000
                }
              }
            },
            "placement": {
              "type": "object",
              "additionalProperties": false,
              "required": ["center", "rotation"],
              "properties": {
                "center": { "$ref": "#/$defs/point" },
                "rotation": { "$ref": "#/$defs/siteAngle" }
              }
            },
            "features": {
              "type": "array",
              "maxItems": 15,
              "items": { "$ref": "#/$defs/siteFeature" }
            }
          }
        },
        "permit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "propertyId": { "type": "string", "maxLength": 120 },
            "address": { "type": "string", "maxLength": 200 },
            "description": { "type": "string", "maxLength": 10000 },
            "separate": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "applicationForm": { "$ref": "#/$defs/permitDocumentStatus" },
                "neighbourNotice": { "$ref": "#/$defs/permitDocumentStatus" },
                "dispensation": { "$ref": "#/$defs/permitDocumentStatus" },
                "consent": { "$ref": "#/$defs/permitDocumentStatus" },
                "authorities": { "$ref": "#/$defs/permitDocumentStatus" },
                "siteConsiderations": { "$ref": "#/$defs/permitDocumentStatus" }
              }
            }
          }
        },
        "area": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clearFloor": { "type": "boolean" },
            "loft": { "type": "boolean" },
            "overhang": { "type": "boolean" },
            "otherArea": { "type": "boolean" }
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/layer" }
    },
    "activeLayerId": { "$ref": "#/$defs/layerId" },
    "renovationView": {
      "enum": ["all", "existing", "demolition", "proposed"]
    },
    "grid": {
      "type": "number",
      "minimum": 1,
      "maximum": 1000,
      "default": 10
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calibrated": {
          "type": "boolean"
        },
        "imported": {
          "type": "boolean"
        },
        "factor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "source": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": ["calibrated", "imported", "factor"],
      "default": {
        "calibrated": true,
        "imported": false,
        "factor": 1
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "maxLength": 1000
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "maxLength": 10000
          }
        }
      },
      "required": ["file", "notes"]
    },
    "items": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "required": ["format", "version", "name", "units", "items"],
  "$defs": {
    "siteAngle": { "type": "number", "minimum": -360, "maximum": 360 },
    "siteFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "points"],
      "properties": {
        "kind": {
          "enum": [
            "boundary",
            "road",
            "building",
            "utility",
            "buildingLine",
            "access",
            "parking"
          ]
        },
        "name": { "type": "string", "maxLength": 36 },
        "correction": { "type": "string", "maxLength": 60 },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/point" }
        }
      },
      "if": { "properties": { "kind": { "const": "parking" } } },
      "then": { "properties": { "points": { "type": "array", "minItems": 3 } } }
    },
    "permitDocumentStatus": {
      "enum": ["supplied", "missing", "notApplicable"]
    },
    "terrainProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existing": { "$ref": "#/$defs/terrainStations" },
        "proposed": { "$ref": "#/$defs/terrainStations" }
      }
    },
    "terrainStations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 150,
      "items": { "$ref": "#/$defs/point" }
    },
    "embeddedRaster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dataUrl", "width", "height"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "dataUrl": {
          "type": "string",
          "maxLength": 3500000,
          "pattern": "^data:image/(png|jpeg);base64,[A-Za-z0-9+/]+={0,2}$"
        },
        "width": { "type": "integer", "minimum": 1, "maximum": 3000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 3000 },
        "page": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "traceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "x",
        "y",
        "width",
        "opacity",
        "locked",
        "visible",
        "calibrated",
        "includeInExport"
      ],
      "properties": {
        "image": { "$ref": "#/$defs/embeddedRaster" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "locked": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "calibrated": { "type": "boolean" },
        "includeInExport": { "type": "boolean" }
      }
    },
    "layerId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "visible", "locked"],
      "properties": {
        "id": { "$ref": "#/$defs/layerId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        }
      },
      "required": ["x", "y"]
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        }
      },
      "required": ["x", "y", "w", "h"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": ["measured", "estimated"]
        },
        "note": {
          "type": "string",
          "maxLength": 10000
        }
      },
      "required": ["basis", "note"]
    },
    "symbol": {
      "oneOf": [
        {
          "$ref": "#/$defs/furniture"
        },
        {
          "$ref": "#/$defs/stairs"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/group"
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "type": "object"
    },
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "layerId": { "$ref": "#/$defs/layerId" },
        "renovationStatus": {
          "enum": ["existing", "demolish", "new"],
          "description": "Omitted means existing. Doors and windows inherit their wall status."
        },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "type": {
          "const": "wall"
        },
        "a": {
          "$ref": "#/$defs/point"
        },
        "b": {
          "$ref": "#/$defs/point"
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "junctions": {
          "description": "Persistent IDs of explicitly joined endpoints. Endpoints sharing an ID must have identical coordinates.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "a": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "b": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      },
      "required": ["id", "name", "type", "a", "b", "thickness"]
    },
    "door": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "type": {
          "const": "door"
        },
        "style": {
          "enum": ["hinged", "sliding"]
        },
        "slideDirection": {
          "enum": [-1, 1]
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "t": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "hinge": {
          "enum": [-1, 1]
        },
        "swing": {
          "enum": [-1, 1]
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "hostId",
        "t",
        "width",
        "hinge",
        "swing"
      ]
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "type": {
          "const": "window"
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "t": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "hinge": {
          "enum": [-1, 1]
        },
        "swing": {
          "enum": [-1, 1]
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "hostId",
        "t",
        "width",
        "hinge",
        "swing"
      ]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "layerId": { "$ref": "#/$defs/layerId" },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "type": {
          "const": "dimension"
        },
        "a": {
          "$ref": "#/$defs/point"
        },
        "b": {
          "$ref": "#/$defs/point"
        },
        "offset": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "anchors": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "a": {
              "$ref": "#/$defs/dimensionAnchor"
            },
            "b": {
              "$ref": "#/$defs/dimensionAnchor"
            }
          }
        }
      },
      "required": ["id", "name", "type", "a", "b", "offset"]
    },
    "furniture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "layerId": { "$ref": "#/$defs/layerId" },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "type": {
          "const": "furniture"
        },
        "x": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "rotation": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "kind": {
          "enum": [
            "sofa",
            "table",
            "chair",
            "bed",
            "cabinet",
            "counter",
            "toilet",
            "shower",
            "fireplace-rounded",
            "fireplace-square"
          ]
        }
      },
      "required": ["id", "name", "type", "x", "y", "w", "h", "rotation", "kind"]
    },
    "stairs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "layerId": { "$ref": "#/$defs/layerId" },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "type": {
          "const": "stairs"
        },
        "x": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "rotation": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "steps": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "x",
        "y",
        "w",
        "h",
        "rotation",
        "steps"
      ]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "layerId": { "$ref": "#/$defs/layerId" },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "type": {
          "const": "text"
        },
        "x": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "rotation": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "text": {
          "type": "string",
          "maxLength": 10000
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "x",
        "y",
        "w",
        "h",
        "rotation",
        "text",
        "fontSize"
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "layerId": { "$ref": "#/$defs/layerId" },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "type": {
          "const": "group"
        },
        "x": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "rotation": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "sourceBox": {
          "$ref": "#/$defs/box"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/symbol"
          }
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "x",
        "y",
        "w",
        "h",
        "rotation",
        "sourceBox",
        "children"
      ]
    },
    "item": {
      "oneOf": [
        {
          "$ref": "#/$defs/wall"
        },
        {
          "$ref": "#/$defs/door"
        },
        {
          "$ref": "#/$defs/window"
        },
        {
          "$ref": "#/$defs/dimension"
        },
        {
          "$ref": "#/$defs/furniture"
        },
        {
          "$ref": "#/$defs/stairs"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/group"
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "type": "object"
    },
    "dimensionAnchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "point": {
          "enum": ["a", "b", "center"]
        }
      },
      "required": ["itemId", "point"]
    }
  }
}
