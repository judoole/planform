{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Planform architectural project v2",
  "description": "Centimeters; X right, Y down; wall endpoints on centerlines; clockwise degrees. See drawing-guide.md for geometry and evidence conventions.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "planform"
    },
    "version": {
      "const": 2
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "units": {
      "const": "cm"
    },
    "showExteriorDimensions": {
      "type": "boolean",
      "description": "Show the live outside-face length of each wall in a calibrated, closed convex footprint. Omitted means hidden."
    },
    "grid": {
      "type": "number",
      "minimum": 1,
      "maximum": 1000,
      "default": 10
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calibrated": {
          "type": "boolean"
        },
        "imported": {
          "type": "boolean"
        },
        "factor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "source": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": ["calibrated", "imported", "factor"],
      "default": {
        "calibrated": true,
        "imported": false,
        "factor": 1
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "maxLength": 1000
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "maxLength": 10000
          }
        }
      },
      "required": ["file", "notes"]
    },
    "items": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "required": ["format", "version", "name", "units", "items"],
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        }
      },
      "required": ["x", "y"]
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        }
      },
      "required": ["x", "y", "w", "h"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": ["measured", "estimated"]
        },
        "note": {
          "type": "string",
          "maxLength": 10000
        }
      },
      "required": ["basis", "note"]
    },
    "symbol": {
      "oneOf": [
        {
          "$ref": "#/$defs/furniture"
        },
        {
          "$ref": "#/$defs/stairs"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/group"
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "type": "object"
    },
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "type": {
          "const": "wall"
        },
        "a": {
          "$ref": "#/$defs/point"
        },
        "b": {
          "$ref": "#/$defs/point"
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        }
      },
      "required": ["id", "name", "type", "a", "b", "thickness"]
    },
    "door": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "type": {
          "const": "door"
        },
        "style": {
          "enum": ["hinged", "sliding"]
        },
        "slideDirection": {
          "enum": [-1, 1]
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "t": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "hinge": {
          "enum": [-1, 1]
        },
        "swing": {
          "enum": [-1, 1]
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "hostId",
        "t",
        "width",
        "hinge",
        "swing"
      ]
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "type": {
          "const": "window"
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "t": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "hinge": {
          "enum": [-1, 1]
        },
        "swing": {
          "enum": [-1, 1]
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "hostId",
        "t",
        "width",
        "hinge",
        "swing"
      ]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "type": {
          "const": "dimension"
        },
        "a": {
          "$ref": "#/$defs/point"
        },
        "b": {
          "$ref": "#/$defs/point"
        },
        "offset": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        }
      },
      "required": ["id", "name", "type", "a", "b", "offset"]
    },
    "furniture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "type": {
          "const": "furniture"
        },
        "x": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "rotation": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "kind": {
          "enum": [
            "sofa",
            "table",
            "chair",
            "bed",
            "cabinet",
            "counter",
            "toilet",
            "shower",
            "fireplace-rounded",
            "fireplace-square"
          ]
        }
      },
      "required": ["id", "name", "type", "x", "y", "w", "h", "rotation", "kind"]
    },
    "stairs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "type": {
          "const": "stairs"
        },
        "x": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "rotation": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "steps": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "x",
        "y",
        "w",
        "h",
        "rotation",
        "steps"
      ]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "type": {
          "const": "text"
        },
        "x": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "rotation": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "text": {
          "type": "string",
          "maxLength": 10000
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "x",
        "y",
        "w",
        "h",
        "rotation",
        "text",
        "fontSize"
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "locked": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "type": {
          "const": "group"
        },
        "x": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "rotation": {
          "type": "number",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "sourceBox": {
          "$ref": "#/$defs/box"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/symbol"
          }
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "x",
        "y",
        "w",
        "h",
        "rotation",
        "sourceBox",
        "children"
      ]
    },
    "item": {
      "oneOf": [
        {
          "$ref": "#/$defs/wall"
        },
        {
          "$ref": "#/$defs/door"
        },
        {
          "$ref": "#/$defs/window"
        },
        {
          "$ref": "#/$defs/dimension"
        },
        {
          "$ref": "#/$defs/furniture"
        },
        {
          "$ref": "#/$defs/stairs"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/group"
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "type": "object"
    }
  }
}
