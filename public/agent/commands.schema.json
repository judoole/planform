{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "planform-commands"
    },
    "version": {
      "const": 1
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "add"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50000,
                "items": {
                  "$ref": "planform.schema.json#/$defs/item"
                }
              }
            },
            "required": ["op", "items"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "opening"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "type": {
                "enum": ["door", "window"]
              },
              "style": {
                "enum": ["hinged", "sliding"]
              },
              "slideDirection": {
                "enum": [-1, 1]
              },
              "hostId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "offset": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000000
              },
              "width": {
                "type": "number",
                "minimum": 1,
                "maximum": 10000000
              },
              "height": {
                "$ref": "planform.schema.json#/$defs/buildingHeight"
              },
              "sill": { "$ref": "planform.schema.json#/$defs/openingSill" },
              "hinge": {
                "enum": [-1, 1]
              },
              "swing": {
                "enum": [-1, 1]
              },
              "evidence": {
                "$ref": "planform.schema.json#/$defs/evidence"
              }
            },
            "required": [
              "op",
              "id",
              "name",
              "type",
              "hostId",
              "offset",
              "width"
            ],
            "if": {
              "properties": {
                "type": {
                  "const": "window"
                }
              }
            },
            "then": {
              "properties": {
                "style": false,
                "slideDirection": false
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "corner"
              },
              "wallId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "end": {
                "enum": ["a", "b"]
              },
              "point": {
                "$ref": "planform.schema.json#/$defs/point"
              }
            },
            "required": ["op", "wallId", "end", "point"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "splitWall"
              },
              "wallId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "offset": {
                "type": "number",
                "minimum": 0,
                "maximum": 30000000
              },
              "segmentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "junctionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": ["op", "wallId", "offset", "segmentId", "junctionId"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "joinWalls"
              },
              "sourceWallId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sourceEnd": {
                "enum": ["a", "b"]
              },
              "targetWallId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "targetOffset": {
                "type": "number",
                "minimum": 0,
                "maximum": 30000000
              },
              "segmentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "junctionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "op",
              "sourceWallId",
              "sourceEnd",
              "targetWallId",
              "targetOffset",
              "segmentId",
              "junctionId"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "update"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "changes": {
                "type": "object",
                "minProperties": 1
              }
            },
            "required": ["op", "id", "changes"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "setExteriorDimensions"
              },
              "show": {
                "type": "boolean"
              }
            },
            "required": ["op", "show"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": { "const": "setBuilding" },
              "building": {
                "anyOf": [
                  { "$ref": "planform.schema.json#/$defs/building" },
                  { "type": "null" }
                ]
              }
            },
            "required": ["op", "building"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "delete"
              },
              "ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50000,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "cascade": {
                "type": "boolean"
              }
            },
            "required": ["op", "ids"]
          }
        ],
        "discriminator": {
          "propertyName": "op"
        },
        "type": "object"
      }
    }
  },
  "required": ["format", "version", "operations"]
}
